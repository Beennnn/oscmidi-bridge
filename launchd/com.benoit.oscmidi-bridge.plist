<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>              <string>com.benoit.oscmidi-bridge</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>-m</string>
    <string>oscmidi_bridge</string>
  </array>
  <key>WorkingDirectory</key>   <string>/Users/benoitbesson/dev/music/oscmidi-bridge</string>
  <!-- KeepAlive : la passerelle doit survivre a un redemarrage de Bome ou de Live.
       Elle ne fait rien de destructeur au demarrage, la relancer est sans risque. -->
  <key>KeepAlive</key>          <true/>
  <key>RunAtLoad</key>          <true/>
  <key>ThrottleInterval</key>   <integer>10</integer>
  <key>StandardOutPath</key>    <string>/Users/benoitbesson/dev/music/oscmidi-bridge/bridge.log</string>
  <key>StandardErrorPath</key>  <string>/Users/benoitbesson/dev/music/oscmidi-bridge/bridge.log</string>
</dict>
</plist>

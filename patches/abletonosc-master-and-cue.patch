+class CueBus:
+    """Live's Cue (headphone) output, dressed as a track so that index -2 reaches
+    it exactly as -1 reaches Main.
+
+    The Cue output is not a Track: its level and its routing hang off `song`
+    directly, which is why no OSC address reached them until now. Every track
+    handler here touches either `mixer_device.<parameter>` or a routing
+    attribute, so a thin proxy is all it takes.
+
+    It deliberately exposes NOTHING else. A call this bus cannot serve raises
+    instead of silently acting on some other object -- the failure mode that
+    makes `tracks[-1]` quietly return the last regular track.
+    """
+
+    def __init__(self, song):
+        self._song = song
+        self.mixer_device = self        # the track API looks for volume here
+
+    @property
+    def volume(self):
+        return self._song.cue_volume
+
+    def _routing(self, name):
+        """Cue routing, if this Live version exposes it.
+
+        `cue_volume` is certain -- Live's own scripts use it. The routing
+        attributes are NOT attested in them, so they are fetched by name and the
+        failure is made explicit: better a message that says which attribute is
+        missing than an AttributeError from somewhere inside the handler.
+        """
+        try:
+            return getattr(self._song, name)
+        except AttributeError:
+            raise AttributeError(
+                "this Live version does not expose song.%s -- the Cue bus (index -2) "
+                "supports volume only here" % name)
+
+    @property
+    def output_routing_type(self):
+        return self._routing("cue_output_routing_type")
+
+    @output_routing_type.setter
+    def output_routing_type(self, value):
+        self._song.cue_output_routing_type = value      # raises if absent, as above
+
+    @property
+    def output_routing_channel(self):
+        return self._routing("cue_output_routing_channel")
+
+    @output_routing_channel.setter
+    def output_routing_channel(self, value):
+        self._song.cue_output_routing_channel = value
+
+    @property
+    def available_output_routing_types(self):
+        return self._routing("available_cue_output_routing_types")
+
+    @property
+    def available_output_routing_channels(self):
+        return self._routing("available_cue_output_routing_channels")
+
+
 class TrackHandler(AbletonOSCHandler):
